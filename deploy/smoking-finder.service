# systemd 서비스: 서버가 꺼지거나 재부팅돼도 자동으로 다시 켜지게 한다.
# 설치 (sudo 필요):
#   sudo cp deploy/smoking-finder.service /etc/systemd/system/
#   sudo nano /etc/systemd/system/smoking-finder.service      # 도메인·사용자·경로 확인
#   sudo systemctl daemon-reload && sudo systemctl enable --now smoking-finder
#   systemctl status smoking-finder        # 상태     journalctl -u smoking-finder -f   # 기록
[Unit]
Description=Cheonan Smoking Area Finder
After=network-online.target
Wants=network-online.target

[Service]
User=user01
WorkingDirectory=/home/user01/smoking_finder
ExecStart=/usr/bin/python3 server.py --host 127.0.0.1 --port 9090 --public-url https://smoke.example.com --behind-proxy
Restart=always
RestartSec=3
Environment=PYTHONUNBUFFERED=1

# 보안: 이 프로그램이 할 수 있는 일을 줄인다 (data/ 폴더에만 쓸 수 있음)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/user01/smoking_finder/data
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
