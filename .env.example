# 천안 흡연장 찾기 설정 파일 예시
# 이 파일을 .env 로 복사해서 값을 채우세요:  cp .env.example .env
# 또는 지금 쓰는 설정을 한 번에 옮기기:       python3 manage.py make-env
# .env 는 GitHub 에 올라가지 않습니다(공유 금지). 빈 값은 무시됩니다.

# ── 보안 ──
SESSION_SECRET=              # 로그인 쿠키 서명 키 (긴 무작위 문자열)

# ── 개발자(관리자) 로그인 ──
ADMIN_LOGIN_ID=
ADMIN_PASSWORD_HASH=         # python3 manage.py hash-password 로 만든 값 (pbkdf2$...)

# ── 소셜 로그인 관리자 ──
ADMIN_EMAILS=                # 쉼표로 여러 개

# ── 소셜 로그인 키 ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 선택 ──
NOTIFY_WEBHOOK_URL=          # 디스코드/슬랙 알림 웹훅
TILES_URL=                   # 지도 그림 업체 주소 (비우면 OpenStreetMap)
TILES_ATTRIBUTION=
PUBLIC_URL=                  # 공개 주소 (Render 에서는 자동이라 비워 두기)
SMOKING_DATA_DIR=            # 데이터 폴더 (비우면 ./data, Render 디스크면 /var/data)
